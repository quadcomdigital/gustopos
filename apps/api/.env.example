# DATABASE_URL: Set via shell environment - DO NOT commit actual credentials.
# Example: "postgresql://user:password@localhost:5432/gustopos"
DATABASE_URL=""

# REDIS_URL: Local Redis connection
REDIS_URL="redis://127.0.0.1:6379"

# JWT_SECRET: Set via shell environment - DO NOT commit actual secrets.
# Must be at least 32 characters in production.
JWT_SECRET=""

# CORS_ORIGIN: Allowed origins (comma-separated)
CORS_ORIGIN="http://localhost:11900"

# Token TTL values (in seconds)
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="604800"

# Server port
PORT="3001"

# Print Bridge endpoint
PRINT_BRIDGE_URL="http://127.0.0.1:11905/print"

# QZ Tray signing key: provision outside any public/static directory.
# Optional absolute path; default is apps/api/signing/private-key.pem.
QZ_SIGNING_KEY_PATH=""

# Default tenant for legacy requests
DEFAULT_TENANT_ID="tenant_legacy"

# Superadmin API key: Set via shell environment - DO NOT commit.
SUPERADMIN_API_KEY=""

# Tenant resolution order
TENANT_RESOLUTION_ORDER="subdomain,slug,jwt,header"

# Superadmin credentials: Set via shell environment - DO NOT commit.
SUPERADMIN_USERNAME=""
SUPERADMIN_PASSWORD=""
SHORT_CODE_PEPPER=<generate with: openssl rand -hex 32>
